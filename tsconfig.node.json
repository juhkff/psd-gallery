{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is needed because scripts/e2e-verify.ts passes callbacks into
    // page.evaluate(), which are serialized and executed inside the browser.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["scripts", "shared"]
}
