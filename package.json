{
  "name": "psd-gallery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GitHub Pages gallery for daily drawing practice: auto-grouped by date, in-browser PSD layer viewer, source PSD download.",
  "scripts": {
    "dev": "npm run manifest && vite",
    "dev:web": "vite",
    "build": "npm run manifest && npm run index && tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "manifest": "tsx scripts/build-manifest.ts",
    "manifest:check": "tsx scripts/build-manifest.ts --check",
    "index": "tsx scripts/build-index.ts",
    "samples": "tsx scripts/samples/generate_samples.ts",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "vitest run",
    "test:e2e": "tsx scripts/e2e-verify.ts",
    "verify:proxy": "tsx scripts/verify-proxy.ts",
    "verify:scale": "tsx scripts/verify-scale-ui.ts",
    "bench:scale": "tsx scripts/bench-scale.ts",
    "verify:workflows": "tsx scripts/verify-workflows.ts",
    "studio": "tsx scripts/studio/server.ts",
    "test:studio": "vitest run scripts/studio",
    "verify:studio": "tsx scripts/studio/verify-studio.ts"
  },
  "dependencies": {
    "ag-psd": "31.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.90",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "puppeteer-core": "^24.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
